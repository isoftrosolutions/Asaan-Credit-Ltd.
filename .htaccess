Options -Indexes

RewriteEngine On
RewriteBase /assan

RewriteRule ^favicon\.ico$ favicon.png [L,R=301]

# Canonical redirect: /discover/businesses.php -> /browse/businesses
RewriteRule ^discover/businesses\.php$ browse/businesses [R=301,L,NC]

# Canonical redirect: old PHP detail URLs -> clean URLs
RewriteCond %{QUERY_STRING} ^id=(\d+)$
RewriteRule ^business/detail\.php$ business/%1 [R=301,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?_path=$1 [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(sql|md|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

RewriteRule ^storage/ - [F,L]
